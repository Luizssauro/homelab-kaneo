# URL pública do frontend
KANEO_CLIENT_URL=https://board.example.com
# Origens permitidas para CORS (separadas por vírgula)
CORS_ORIGINS=https://board.example.com

# Banco de dados (o DATABASE_URL é montado pelo docker-compose a partir destes)
POSTGRES_DB=kaneo
POSTGRES_USER=kaneo
POSTGRES_PASSWORD=troque-por-um-segredo-forte

# Segredo de autenticação (gere com: openssl rand -hex 32)
AUTH_SECRET=troque-por-um-segredo-forte

# Desabilita acesso de convidado
DISABLE_GUEST_ACCESS=true
